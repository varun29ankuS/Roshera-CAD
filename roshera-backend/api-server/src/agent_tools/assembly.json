        "result": {
          "image": "png_base64",
          "caption": "assembly az={az}° el={el}° instances={$instance_count} distinct_parts={$unique_part_count} open={$open_edges} nm={$nonmanifold_edges}"
        }
      },
      "examples": [
        {
          "title": "a diagnostic view",
          "args": {
            "assembly_id": "11111111-1111-4111-8111-111111111111",
            "mode": "diagnostic"
          }
        }
      ]
    },
    {
      "name": "assembly_mate",
      "bench": "assembly",
      "stability": "experimental",
      "effects": "mutates",
      "idempotent": false,
      "summary": "Mate two instances — connectors + mate in one call. A mate relates two coordinate frames and IS the joint.",
      "description": "MATE two instances — connectors + mate in ONE call. A mate relates two FRAMES and IS the joint (exact DOF by construction).\nJOINTS: Fastened (0 DOF) · Revolute{limits} (1 rot/z) · Slider{limits} (1 trans/z) · Cylindrical{rot_limits,trans_limits} · Planar (2 trans+spin) · Ball (3 rot) · PinSlot{slot_dir_x,limits}. OVERLAYS: Distance{value} mm · Angle{value} rad · Parallel · Tangent. COUPLINGS (pass `couples` = related mate ids): GearRatio{ratio} & RackPinion{pinion_radius} take 2, Screw{lead} takes 1.\nREFUSED (typed): Cam, Path, Symmetric.\nLIMITS (rot=rad, trans=mm) give assembly_certify a finite range: a rotation without limits sweeps a full turn; a translation without limits refuses certification.",
      "input_schema": {
        "type": "object",
        "properties": {
          "assembly_id": {
            "type": "string",
            "format": "uuid",
            "description": "assembly id"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "edit",
              "remove"
            ],
            "default": "create",
            "description": "create a mate (+ its connectors), edit its kind, or remove it"
          },
          "kind": {
            "description": "the mate kind, e.g. 'Fastened' or {Revolute:{limits:[-0.1,0.1]}} (required for create/edit)"
          },
          "a": {
            "type": "object",
            "properties": {
              "instance_id": {
                "type": "string",
                "format": "uuid",
                "description": "the instance this frame sits on"
              },
              "label": {
                "type": "string",
                "description": "DURABLE (best): a face label; follows the face through edits"
              },
              "pid": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "raw persistent face id, 32 lowercase hex digits as select_face / Kernel Lens / user_context report it (durable, unnamed)"
              },
              "face_id": {
                "type": "integer",
                "minimum": 0,
                "description": "live kernel face id; durability derived (PID if any, else fingerprint)"
              },
              "frame": {
                "type": "object",
                "properties": {
                  "origin": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "origin [x,y,z] mm"
                  },
                  "z_axis": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "z axis (the joint axis)"
                  },
                  "x_axis": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "x axis"
                  }
                },
                "required": [
                  "origin",
                  "z_axis",
                  "x_axis"
                ],
                "additionalProperties": false,
                "description": "RAW coords (NOT durable); must sit on real geometry or certify refuses it"
              }
            },
            "required": [
              "instance_id"
            ],
            "additionalProperties": false,
            "description": "side A connector (required for create)"
          },
          "b": {
            "type": "object",
            "properties": {
              "instance_id": {
                "type": "string",
                "format": "uuid",
                "description": "the instance this frame sits on"
              },
              "label": {
                "type": "string",
                "description": "DURABLE (best): a face label; follows the face through edits"
              },
              "pid": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "raw persistent face id, 32 lowercase hex digits as select_face / Kernel Lens / user_context report it (durable, unnamed)"
              },
              "face_id": {
                "type": "integer",
                "minimum": 0,
                "description": "live kernel face id; durability derived (PID if any, else fingerprint)"
              },
              "frame": {
                "type": "object",
                "properties": {
                  "origin": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "origin [x,y,z] mm"
                  },
                  "z_axis": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "z axis (the joint axis)"
                  },
                  "x_axis": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "x axis"
                  }
                },
                "required": [
                  "origin",
                  "z_axis",
                  "x_axis"
                ],
                "additionalProperties": false,
                "description": "RAW coords (NOT durable); must sit on real geometry or certify refuses it"
              }
            },
            "required": [
              "instance_id"
            ],
            "additionalProperties": false,
            "description": "side B connector (required for create)"
          },
          "couples": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "for coupling kinds: the related mate ids"
          },
          "mate_id": {
            "type": "string",
            "format": "uuid",
            "description": "the mate to edit/remove"
          }
        },
        "required": [
          "assembly_id"
        ],
        "additionalProperties": false
      },
      "call": {
        "switch": "action",
        "cases": {
          "create": {
            "requires": [
              "kind",
              "a",
              "b"
            ],
            "method": "POST",
            "path": "/api/assembly/{assembly_id}/joint",
            "body": {
              "kind": {
                "$arg": "kind"
              },
              "a": {
                "$arg": "a"
              },
              "b": {
                "$arg": "b"
              },
              "couples": {
                "$arg": "couples",
                "default": null
              }
            }
          },
          "edit": {
            "requires": [
              "mate_id",
              "kind"
            ],
            "method": "PATCH",
            "path": "/api/assembly/{assembly_id}/mate/{mate_id}",
            "body": {
              "kind": {
                "$arg": "kind"
              }
            }
          },
          "remove": {
            "requires": [
              "mate_id"
            ],
            "method": "DELETE",
            "path": "/api/assembly/{assembly_id}/mate/{mate_id}"
          }
        }
      },
      "examples": [
        {
          "title": "a hinge on a labelled bore, the other side anchored by persistent id",
          "args": {
            "assembly_id": "11111111-1111-4111-8111-111111111111",
            "kind": {
              "Revolute": {
                "limits": [
                  -1.57,
                  1.57
                ]
              }
            },
            "a": {
              "instance_id": "22222222-2222-4222-8222-222222222222",
              "label": "hinge_bore"
            },
            "b": {
              "instance_id": "33333333-3333-4333-8333-333333333333",
              "pid": "0123456789abcdef0123456789abcdef"
            }
          }
        },
        {
          "title": "remove a mate",
          "args": {
            "assembly_id": "11111111-1111-4111-8111-111111111111",
            "action": "remove",
            "mate_id": "44444444-4444-4444-8444-444444444444"
          }
        }
      ]
    },
    {
      "name": "assembly_solve",
      "bench": "assembly",
      "stability": "experimental",
      "effects": "mutates",
      "idempotent": true,
      "summary": "Solve the mate system: parts are placed by their mates; returns solved poses, per-mate facts, and a compact verdict.",
      "description": "SOLVE the mate system: parts are PLACED by their mates. Returns each instance's solved pose, per-mate facts (enforced/violation/anchor) and a verdict (constrainedness + conflict witnesses). `converged:false` = the mates cannot all hold; the witnesses name which fight.",
      "input_schema": {
        "type": "object",
        "properties": {
          "assembly_id": {
            "type": "string",
            "format": "uuid",
            "description": "assembly id"
          },
          "ground": {
            "type": "string",
            "format": "uuid",
            "description": "grounded instance (default: first)"
          }
        },
        "required": [
          "assembly_id"
        ],
        "additionalProperties": false
      },
      "call": {
        "method": "POST",
        "path": "/api/assembly/{assembly_id}/solve",
        "body": {
          "ground": {
            "$arg": "ground",
            "default": null
          }
        }
      },
      "examples": [
        {
          "title": "solve with the first instance grounded",
          "args": {
            "assembly_id": "11111111-1111-4111-8111-111111111111"
          }
        }
      ]
    },
    {
      "name": "assembly_certify",
      "bench": "assembly",
      "stability": "experimental",
      "effects": "read_only",
      "idempotent": true,
      "summary": "The full assembly certificate — does this go together AND move without collision? is_sound = AND of mates/grounding/clearance dims.",
      "description": "THE FULL CERTIFICATE. `is_sound` = AND of: mates_consistent · fully_grounded (no floating part) · no_static_interference · swept_clearance_ok · mates_anchored (no invented coordinate) · mates_in_contact · mates_enforced. Mobility is REPORTED, not failed. `sweeps` = one fact per motion (continuous TOI, no tunneling) with ε and any contact; an uncertifiable sweep REFUSES with a reason. Certified clearance = distance − ε.",
      "input_schema": {
        "type": "object",
        "properties": {
          "assembly_id": {
            "type": "string",
            "format": "uuid",
            "description": "assembly id"
          },
          "ground": {
            "type": "string",
            "format": "uuid",
            "description": "grounded instance"
          },
          "epsilon": {
            "type": "number",
            "description": "clearance margin (mm); honoured only ABOVE the kernel floor"
          }
        },
        "required": [
          "assembly_id"
        ],
        "additionalProperties": false
      },
      "call": {
        "method": "POST",
        "path": "/api/assembly/{assembly_id}/certify",
        "body": {
          "ground": {
            "$arg": "ground",
            "default": null
          },
          "epsilon": {
